PORT=4000
DATA_PATH=./data/db.json
# Comma-separated browser origins allowed to call the API (Vercel admin + shop URLs in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
# Public HTTPS origin of this API (no trailing slash). Required in production for upload image URLs.
# PUBLIC_API_ORIGIN=https://your-api.onrender.com
